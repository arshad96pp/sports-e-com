# Supabase project credentials. For local dev, run `pnpm db:start` — it prints
# these values (API_URL / ANON_KEY / SERVICE_ROLE_KEY) for the local stack.
# For production, use your hosted project's Settings → API values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for the Supabase CLI only (db push / migration
# list against a hosted project) — the app itself never reads this. Not needed for
# local dev (the CLI talks to the local stack without it). Settings → Database for
# the host/password; percent-encode special characters in the password.
DATABASE_URL=

# WhatsApp number the store owner receives Buy Now / order confirmations on.
# Use full international format, digits only, no "+" or spaces.
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Canonical production URL, used for metadata, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.stryde.in

# Credentials the seed script (`pnpm seed`) creates for the super admin login.
SEED_SUPER_ADMIN_EMAIL=admin@stryde.in
SEED_SUPER_ADMIN_PASSWORD=change-me
